# Kaggle Configuration
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_kaggle_key

# Database (PostgreSQL/Supabase)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=postgres

# AI Services
HF_TOKEN=your_huggingface_token
GROQ_API_KEY=your_groq_api_key

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=eco-agronomist

# Security
SECRET_KEY=your_secret_key

# Model Paths
PLANT_MODEL_PATH=artifacts/plants/model.pt
VALORISATION_MODEL_PATH=artifacts/products/model.pt
CONSUMER_MODEL_PATH=artifacts/products/model.pt

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Git
GIT_PYTHON_REFRESH=quiet

# RAG Data Paths (PDFs)
ONSSA_PDF1_PATH=./data/raw/RAG/Corpus_phytosanitaire_textuel_ONSSA.pdf
ONSSA_PDF2_PATH=./data/raw/RAG/Corpus_phytosanitaire_ONSSA.pdf
